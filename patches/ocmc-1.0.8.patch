+  { 0x00, 0x00, 0x00, 0x00, 0x00, 0x7C, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x00, 0x00, 0x00, 0x00 },  // 0x6E 'n'
+  { 0x00, 0x00, 0x00, 0x00, 0x00, 0x3C, 0x66, 0x66, 0x66, 0x66, 0x66, 0x3C, 0x00, 0x00, 0x00, 0x00 },  // 0x6F 'o'
+  { 0x00, 0x00, 0x00, 0x00, 0x00, 0x7C, 0x66, 0x66, 0x66, 0x66, 0x66, 0x7C, 0x60, 0x60, 0x60, 0x00 },  // 0x70 'p'
+  { 0x00, 0x00, 0x00, 0x00, 0x00, 0x3E, 0x66, 0x66, 0x66, 0x66, 0x66, 0x3E, 0x06, 0x06, 0x06, 0x00 },  // 0x71 'q'
+  { 0x00, 0x00, 0x00, 0x00, 0x00, 0x6E, 0x70, 0x60, 0x60, 0x60, 0x60, 0x60, 0x00, 0x00, 0x00, 0x00 },  // 0x72 'r'
+  { 0x00, 0x00, 0x00, 0x00, 0x00, 0x3E, 0x60, 0x70, 0x3C, 0x0E, 0x06, 0x7C, 0x00, 0x00, 0x00, 0x00 },  // 0x73 's'
+  { 0x00, 0x00, 0x00, 0x30, 0x30, 0x7E, 0x30, 0x30, 0x30, 0x30, 0x30, 0x1E, 0x00, 0x00, 0x00, 0x00 },  // 0x74 't'
+  { 0x00, 0x00, 0x00, 0x00, 0x00, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x3E, 0x00, 0x00, 0x00, 0x00 },  // 0x75 'u'
+  { 0x00, 0x00, 0x00, 0x00, 0x00, 0x66, 0x66, 0x66, 0x66, 0x66, 0x3C, 0x18, 0x00, 0x00, 0x00, 0x00 },  // 0x76 'v'
+  { 0x00, 0x00, 0x00, 0x00, 0x00, 0x6B, 0x6B, 0x6B, 0x6B, 0x6B, 0x6B, 0x7E, 0x00, 0x00, 0x00, 0x00 },  // 0x77 'w'
+  { 0x00, 0x00, 0x00, 0x00, 0x00, 0x66, 0x66, 0x3C, 0x18, 0x3C, 0x66, 0x66, 0x00, 0x00, 0x00, 0x00 },  // 0x78 'x'
+  { 0x00, 0x00, 0x00, 0x00, 0x00, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x3E, 0x06, 0x06, 0x3C, 0x00 },  // 0x79 'y'
+  { 0x00, 0x00, 0x00, 0x00, 0x00, 0x7E, 0x06, 0x0C, 0x18, 0x30, 0x60, 0x7E, 0x00, 0x00, 0x00, 0x00 },  // 0x7A 'z'
+  { 0x00, 0x0E, 0x18, 0x18, 0x18, 0x18, 0x18, 0xF0, 0x18, 0x18, 0x18, 0x18, 0x18, 0x0E, 0x00, 0x00 },  // 0x7B '{'
+  { 0x00, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x00, 0x00 },  // 0x7C '|'
+  { 0x00, 0x70, 0x18, 0x18, 0x18, 0x18, 0x18, 0x0F, 0x18, 0x18, 0x18, 0x18, 0x18, 0x70, 0x00, 0x00 },  // 0x7D '}'
+  { 0x00, 0x00, 0x33, 0x7B, 0x6F, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 },  // 0x7E '~'
